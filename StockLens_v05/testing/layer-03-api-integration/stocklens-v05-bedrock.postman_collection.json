{
  "info": {
    "name": "StockLens v05 - Layer 03 Bedrock Contract",
    "description": "Prueba opcional del contrato real con Bedrock. No valida una descripcion exacta.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://127.0.0.1:3000" }],
  "item": [{
    "name": "Analizar imagen con Bedrock",
    "request": {
      "method": "POST",
      "header": [{ "key": "Content-Type", "value": "application/json" }],
      "body": {
        "mode": "raw",
        "raw": "{\"imageDataUrl\":\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=\"}"
      },
      "url": "{{baseUrl}}/analyze"
    },
    "event": [{
      "listen": "test",
      "script": { "exec": [
        "pm.test('Bedrock responde 200', () => pm.response.to.have.status(200));",
        "pm.test('sugerencia estructurada', () => {",
        "  const suggestion = pm.response.json().suggestion;",
        "  pm.expect(suggestion.name).to.be.a('string').and.not.empty;",
        "  pm.expect(suggestion.category).to.be.a('string').and.not.empty;",
        "  pm.expect(suggestion.tags).to.be.an('array');",
        "  pm.expect(suggestion.checklist).to.be.an('array').and.not.empty;",
        "});"
      ] }
    }]
  }]
}
