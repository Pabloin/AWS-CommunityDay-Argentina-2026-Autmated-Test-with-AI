{
  "info": {
    "name": "StockLens v05 - Layer 03 Core Integration",
    "description": "Contrato HTTP y persistencia real con limpieza automatica.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('testItemId')) {",
          "  const suffix = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`.toUpperCase();",
          "  pm.collectionVariables.set('testItemId', `TEST-L3-${suffix}`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "testItemId", "value": "" },
    { "key": "photoUrl", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Health atraviesa API Gateway y Lambda",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('status 200', () => pm.response.to.have.status(200));",
          "pm.test('contrato de salud', () => {",
          "  const body = pm.response.json();",
          "  pm.expect(body.service).to.eql('stocklens-v05-api');",
          "  pm.expect(body.status).to.eql('ok');",
          "  pm.expect(body.storage.itemsTable).to.be.a('string').and.not.empty;",
          "  pm.expect(body.storage.photosBucket).to.be.a('string').and.not.empty;",
          "});"
        ] }
      }]
    },
    {
      "name": "02 - CORS permite clientes web",
      "request": {
        "method": "OPTIONS",
        "header": [
          { "key": "Origin", "value": "https://mobile-v5.lens.glaciar.org" },
          { "key": "Access-Control-Request-Method", "value": "GET" }
        ],
        "url": "{{baseUrl}}/items"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('preflight aceptado', () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));",
          "pm.test('expone CORS', () => pm.expect(pm.response.headers.get('access-control-allow-origin')).to.exist);"
        ] }
      }]
    },
    {
      "name": "03 - Un item inexistente responde 404",
      "request": { "method": "GET", "url": "{{baseUrl}}/items/TEST-L3-NO-EXISTE" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('status 404', () => pm.response.to.have.status(404));",
          "pm.test('error estable', () => pm.expect(pm.response.json().error).to.eql('item_not_found'));"
        ] }
      }]
    },
    {
      "name": "04 - Crear item persiste metadata y foto",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{testItemId}}\",\n  \"name\": \"Objeto de integracion Layer 03\",\n  \"category\": \"Objeto\",\n  \"location\": \"Pipeline GitHub Actions\",\n  \"status\": \"review\",\n  \"notes\": \"Dato temporal creado por Newman\",\n  \"checklist\": [\"API\", \"DynamoDB\", \"S3\", \"QR\"],\n  \"checked\": [\"API\"],\n  \"photos\": [\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=\"]\n}"
        },
        "url": "{{baseUrl}}/items"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('status 201', () => pm.response.to.have.status(201));",
          "pm.test('contrato del item creado', () => {",
          "  const body = pm.response.json();",
          "  pm.expect(body.id).to.eql(pm.collectionVariables.get('testItemId'));",
          "  pm.expect(body.name).to.eql('Objeto de integracion Layer 03');",
          "  pm.expect(body.photoCount).to.eql(1);",
          "  pm.expect(body.photos).to.have.lengthOf(1);",
          "  pm.expect(body.photos[0].key).to.include(`/items/${body.id}/photos/`);",
          "  pm.collectionVariables.set('photoUrl', body.photos[0].url);",
          "});"
        ] }
      }]
    },
    {
      "name": "05 - Leer item confirma DynamoDB",
      "request": { "method": "GET", "url": "{{baseUrl}}/items/{{testItemId}}" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('status 200', () => pm.response.to.have.status(200));",
          "pm.test('round trip de persistencia', () => {",
          "  const body = pm.response.json();",
          "  pm.expect(body.id).to.eql(pm.collectionVariables.get('testItemId'));",
          "  pm.expect(body.location).to.eql('Pipeline GitHub Actions');",
          "  pm.expect(body.checklist).to.include('DynamoDB');",
          "});"
        ] }
      }]
    },
    {
      "name": "06 - Descargar foto confirma S3 firmado",
      "request": { "method": "GET", "url": "{{photoUrl}}" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('foto accesible', () => pm.response.to.have.status(200));",
          "pm.test('contenido PNG', () => pm.expect(pm.response.headers.get('content-type')).to.include('image/png'));",
          "pm.test('tiene bytes', () => pm.expect(pm.response.responseSize).to.be.above(0));"
        ] }
      }]
    },
    {
      "name": "07 - Generar QR confirma endpoint SVG",
      "request": { "method": "GET", "url": "{{baseUrl}}/items/{{testItemId}}/qr" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('status 200', () => pm.response.to.have.status(200));",
          "pm.test('devuelve SVG', () => {",
          "  pm.expect(pm.response.headers.get('content-type')).to.include('image/svg+xml');",
          "  pm.expect(pm.response.text()).to.include('<svg');",
          "});"
        ] }
      }]
    },
    {
      "name": "99 - Limpiar item, foto S3 y registro DynamoDB",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/test-support/items/{{testItemId}}" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('limpieza completada', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
          "if (pm.response.code === 200) {",
          "  pm.test('borro el ID correcto', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('testItemId')));",
          "}"
        ] }
      }]
    }
  ]
}
